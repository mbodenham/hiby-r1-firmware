#!/bin/sh
#
#  config wifi
#

# plan B2: the wlan0 wait/poll (up to ~3 s) no longer blocks rcS; the MAC
# setup runs in the background, and wifi_up.sh re-runs it before wifi is
# actually brought up.

case "$1" in
	start)
		# 设置mac地址
		wifi_set_mac.sh start &
	;;

	stop)
		# 关闭wifi
		wifi_down.sh
	;;
  *)

	echo "Usage: $0 {start|stop|restart}"
	exit 1

esac

exit $?
