#!/bin/sh
#
# Start sys_server....
#

case "$1" in
  start)
	echo "Starting sys_server..."
	# make sure the /mnt dir is empty
	rm -rf /mnt/*
	# plan B5: sys_server threads write a continuous debug stream to the
	# inherited /dev/console fds — disconnect them from the serial console.
	/usr/bin/sys_server >/dev/null 2>&1 &
	;;
  stop)
	echo "Stopping sys_server..."
	killall sys_server
	;;
  restart|reload)
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?
